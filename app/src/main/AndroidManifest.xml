<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission, by design (brief §26). This app has no analytics, no ads, no
      account system, and nothing to send anywhere. Calibration and tuning stay on device.
    -->

    <uses-feature
        android:name="android.hardware.sensor.hinge_angle"
        android:required="false" />

    <application
        android:name=".FoldPhaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldPhase">

        <!--
          configChanges: folding a Fold device changes screenSize, smallestScreenSize,
          screenLayout, orientation and density all at once. Declaring them means the
          activity is NOT destroyed and recreated mid-fold — which would drop exactly the
          frames the transition is made of (brief §19).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.FoldPhase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Launcher mode (brief §2 Level B). Opt-in: the user must pick FoldPhase as their
          home app in Settings. It is never installed as the default.
        -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.FoldPhase.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
